# Porta do servidor
PORT=8080
# Segredo do JWT (troque em produção)
JWT_SECRET=troque-este-segredo-em-producao
# Caminho do arquivo do banco SQLite
DB_PATH=./data/agency.db

# Token da porta de serviço (/api/admin) para um painel central externo criar
# empresas/usuários e ler o uso. Se ficar vazio, a porta fica DESLIGADA (503).
# Use um valor longo e aleatório.
SERVICE_TOKEN=

# Chave de criptografia dos segredos guardados no banco (tokens Meta/Asaas/IA).
# Se vazio, usa o JWT_SECRET (compatível com o que já está cifrado). Defina-a
# = valor atual do JWT_SECRET ANTES de rotacionar o JWT_SECRET.
ENCRYPTION_KEY=

# Senhas iniciais dos usuários-semente (só na primeira criação). Defina em
# produção para não nascer com "001".
SEED_ADMIN_PASSWORD=
SEED_KATY_PASSWORD=

# Cloudflare R2 (armazenamento das fotos/vídeos). Se as 4 estiverem definidas,
# o sistema usa o R2; senão, guarda no disco. Depois de definir, rode
# "npm run migrate-r2" uma vez para mover os arquivos já existentes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Publicação direta na Meta (Instagram/Facebook) — opcional.
# Crie um app em https://developers.facebook.com/apps e preencha:
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://seu-dominio.com.br/api/integrations/meta/callback
# Endereço público do sistema (a Meta precisa alcançar as artes):
PUBLIC_URL=https://seu-dominio.com.br
